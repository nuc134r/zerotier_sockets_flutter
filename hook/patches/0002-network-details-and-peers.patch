+int NodeService::networkDetails(uint64_t net_id, char* dst, unsigned int len)
+{
+    // nux: the network's addresses and routes as text, read under the lock (the zts_core_query_* calls
+    // need the caller to hold it, and zts_addr_get_all overflows its array past 16 addresses):
+    //   addr <address>/<prefix length>
+    //   route <target>/<prefix length> <gateway, - when none> <flags> <metric>
+    // Returns the length of the whole text; dst gets as much as fits, terminated.
+    if (dst && len) {
+        dst[0] = 0;
+    }
+    std::string out;
+    {
+        Mutex::Lock _l(_nets_m);
+        std::map<uint64_t, NetworkState>::const_iterator n(_nets.find(net_id));
+        if (n == _nets.end()) {
+            return ZTS_ERR_NO_RESULT;
+        }
+        const ZT_VirtualNetworkConfig& c = n->second.config;
+        char a[64];
+        char line[200];
+        for (unsigned int i = 0; i < c.assignedAddressCount && i < ZT_MAX_ZT_ASSIGNED_ADDRESSES; i++) {
+            snprintf(line, sizeof(line), "addr %s\n", InetAddress(&(c.assignedAddresses[i])).toString(a));
+            out += line;
+        }
+        for (unsigned int i = 0; i < c.routeCount && i < ZT_MAX_NETWORK_ROUTES; i++) {
+            char via[64] = "-";
+            const InetAddress gw(&(c.routes[i].via));
+            if (gw.ss_family == AF_INET || gw.ss_family == AF_INET6) {
+                gw.toIpString(via);
+            }
+            snprintf(
+                line,
+                sizeof(line),
+                "route %s %s %u %u\n",
+                InetAddress(&(c.routes[i].target)).toString(a),
+                via,
+                (unsigned)c.routes[i].flags,
+                (unsigned)c.routes[i].metric);
+            out += line;
+        }
+    }
+    if (dst && len) {
+        snprintf(dst, len, "%s", out.c_str());
+    }
+    return (int)out.size();
+}
+
+int NodeService::peerList(char* dst, unsigned int len) const
+{
+    // nux: one line per peer: address role latency version, then its live paths (address/port, * when
+    // preferred). Returns the length of the whole list; dst gets as much as fits, terminated.
+    if (! _node) {
+        return ZTS_ERR_SERVICE;
+    }
+    if (dst && len) {
+        dst[0] = 0;
+    }
+    ZT_PeerList* pl = _node->peers();
+    if (! pl) {
+        return 0;
+    }
+    std::string out;
+    char line[96];
+    char addr[64];
+    for (unsigned long i = 0; i < pl->peerCount; i++) {
+        const ZT_Peer& p = pl->peers[i];
+        snprintf(
+            line,
+            sizeof(line),
+            "%.10llx %d %d %d.%d.%d",
+            (unsigned long long)p.address,
+            (int)p.role,
+            p.latency,
+            p.versionMajor,
+            p.versionMinor,
+            p.versionRev);
+        out += line;
+        for (unsigned int j = 0; j < p.pathCount && j < ZT_MAX_PEER_NETWORK_PATHS; j++) {
+            if (p.paths[j].expired) {
+                continue;
+            }
+            out += ' ';
+            out += InetAddress(&(p.paths[j].address)).toString(addr);
+            if (p.paths[j].preferred) {
+                out += '*';
+            }
+        }
+        out += '\n';
+    }
+    _node->freeQueryResult((void*)pl);
+    if (dst && len) {
+        snprintf(dst, len, "%s", out.c_str());
+    }
+    return (int)out.size();
+}
