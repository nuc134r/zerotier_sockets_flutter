+int zts_lwip_neighbors(char* dst, unsigned int len)
+{
+    // nux: the IPv4 neighbors the stack has resolved (its ARP table), one per line:
+    //   <network id> <IP address> <ZeroTier address of the member>
+    // A member's MAC is made from its ZeroTier address and the network id, so it gives the address back.
+    // Returns the length of the whole text; dst gets as much as fits, terminated.
+    if (dst && len) {
+        dst[0] = 0;
+    }
+    if (! _has_started) {
+        return 0;
+    }
+    std::string out;
+    char line[96];
+    char ip[IP4ADDR_STRLEN_MAX];
+    LOCK_TCPIP_CORE();
+    for (size_t i = 0; i < ARP_TABLE_SIZE; i++) {
+        ip4_addr_t* addr = NULL;
+        struct netif* n = NULL;
+        struct eth_addr* eth = NULL;
+        if (! etharp_get_entry(i, &addr, &n, &eth) || ! n || ! n->state) {
+            continue;
+        }
+        const uint64_t nwid = ((VirtualTap*)n->state)->_net_id;
+        uint64_t mac = 0;
+        for (int b = 0; b < 6; b++) {
+            mac = (mac << 8) | eth->addr[b];
+        }
+        const uint64_t member = MAC(mac).toAddress(nwid).toInt();
+        ip4addr_ntoa_r(addr, ip, sizeof(ip));
+        snprintf(line, sizeof(line), "%.16llx %s %.10llx\n", (unsigned long long)nwid, ip, (unsigned long long)member);
+        out += line;
+    }
+    UNLOCK_TCPIP_CORE();
+    if (dst && len) {
+        snprintf(dst, len, "%s", out.c_str());
+    }
+    return (int)out.size();
+}
