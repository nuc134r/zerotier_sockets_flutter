+int zts_core_set_udp_relay(const char* ip, unsigned short port)
+{
+    // nux: see NodeService::setUdpRelay. No service needed: it applies to a node started later too.
+    if (! ip) {
+        NodeService::setUdpRelay(0, NULL);
+        return ZTS_ERR_OK;
+    }
+    if (! *ip) {
+        NodeService::setUdpRelay(2, NULL);
+        return ZTS_ERR_OK;
+    }
+    struct sockaddr_storage ss;
+    memset(&ss, 0, sizeof(ss));
+    if (strchr(ip, ':')) {
+        struct sockaddr_in6* in6 = reinterpret_cast<struct sockaddr_in6*>(&ss);
+        if (inet_pton(AF_INET6, ip, &(in6->sin6_addr)) != 1) {
+            return ZTS_ERR_ARG;
+        }
+        in6->sin6_family = AF_INET6;
+        in6->sin6_port = htons(port);
+    }
+    else {
+        struct sockaddr_in* in4 = reinterpret_cast<struct sockaddr_in*>(&ss);
+        if (inet_pton(AF_INET, ip, &(in4->sin_addr)) != 1) {
+            return ZTS_ERR_ARG;
+        }
+        in4->sin_family = AF_INET;
+        in4->sin_port = htons(port);
+    }
+    if (! port) {
+        return ZTS_ERR_ARG;
+    }
+    NodeService::setUdpRelay(1, &ss);
+    return ZTS_ERR_OK;
+}
