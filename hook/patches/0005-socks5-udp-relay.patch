+// nux: the SOCKS5 UDP relay all ZeroTier packets go through (NodeService::setUdpRelay)
+static Mutex _relay_m;
+static int _relayMode = 0;
+static InetAddress _relayAddr;
+
+void NodeService::setUdpRelay(int mode, const struct sockaddr_storage* relay)
+{
+    Mutex::Lock _l(_relay_m);
+    _relayMode = (mode == 1 && ! relay) ? 2 : mode;
+    if (relay) {
+        _relayAddr = *reinterpret_cast<const InetAddress*>(relay);
+    }
+    else {
+        _relayAddr.zero();
+    }
+}
+
+int NodeService::udpRelayMode(InetAddress* relay)
+{
+    Mutex::Lock _l(_relay_m);
+    if (relay) {
+        *relay = _relayAddr;
+    }
+    return _relayMode;
+}
