+/**
+ * @brief (nux) Sends all of ZeroTier's traffic through a SOCKS5 UDP relay: the address a SOCKS5 server
+ * gave for a UDP ASSOCIATE (the caller keeps that association's TCP connection open). Every packet is
+ * wrapped in a SOCKS5 UDP request header and sent to the relay; only datagrams from the relay are taken,
+ * and this device's own addresses are not advertised to peers.
+ *
+ * @param ip The relay's IP address; NULL for direct UDP again (the default); "" to hold: send and take
+ * nothing until a relay is set (e.g. while the association is being made again). Applies to a running
+ * node at once and to nodes started later.
+ * @param port The relay's UDP port.
+ * @return `ZTS_ERR_OK`, or `ZTS_ERR_ARG` if ip is not an IP address or port is 0.
+ */
+ZTS_API int ZTCALL zts_core_set_udp_relay(const char* ip, unsigned short port);
